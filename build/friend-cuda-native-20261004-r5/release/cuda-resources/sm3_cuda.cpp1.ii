          void cuda_fors_parent(const a15_cuda_job &job,unsigned height,uint32_t relative,const uint8_t *nodes,uint8_t out[16]){
 uint8_t address[32];for(unsigned j=0;j<32;j++)address[j]=job.adrs[j];cuda_put32(address+16,3);
